#!/sbin/openrc-run

name="relaydeck-lite"
description="RelayDeck Lite TCP/UDP relay"
command="/usr/local/bin/relaydeck-lite"
command_args_foreground="run --config /etc/relaydeck-lite/rules.json --socket /run/relaydeck-lite.sock"
command_user="root:root"
directory="/var/lib/relaydeck-lite"
pidfile="/run/relaydeck-lite.pid"
supervisor=supervise-daemon
supervise_daemon_args="--respawn-delay 2 --respawn-max 10 --respawn-period 60"
retry="SIGTERM/10 SIGKILL/5"
umask=0077

start_pre() {
	ulimit -n 65535 || return 1
}

depend() {
	need net
	after firewall
}
