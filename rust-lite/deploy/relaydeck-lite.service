[Unit]
Description=RelayDeck Lite TCP/UDP relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/relaydeck-lite
ExecStart=/usr/local/bin/relaydeck-lite run --config /etc/relaydeck-lite/rules.json --socket /run/relaydeck-lite.sock
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
KillMode=mixed
UMask=0077
LimitNOFILE=65535
MemoryMax=96M
CPUQuota=15%
TasksMax=2048
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/relaydeck-lite /var/lib/relaydeck-lite /run
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
